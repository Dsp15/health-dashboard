# Copy this file to .env and fill in your values.
# Never commit .env to GitHub — it contains your secrets.

# Whoop API credentials
# Get these from: https://developer-dashboard.whoop.com
WHOOP_CLIENT_ID=your_client_id_here
WHOOP_CLIENT_SECRET=your_client_secret_here

# The redirect URI you set in the Whoop developer dashboard
# For local development, use this exact value:
WHOOP_REDIRECT_URI=http://localhost:8080/callback
