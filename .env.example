# Copy this file to .env and fill in your values.
# Never commit .env to GitHub — it contains your secrets.

# Whoop API credentials
# Get these from: https://developer-dashboard.whoop.com
WHOOP_CLIENT_ID=your_client_id_here
WHOOP_CLIENT_SECRET=your_client_secret_here

# The redirect URI you set in the Whoop developer dashboard
# For local development, use this exact value:
WHOOP_REDIRECT_URI=http://localhost:8080/callback

# Garmin Connect credentials
# Your regular Garmin Connect login (email + password)
GARMIN_EMAIL=your_garmin_email_here
GARMIN_PASSWORD=your_garmin_password_here

# Anthropic API key — used for the AI Weekly Summary card
# Get your key at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Your location for weather and air quality data
# Used by weather_client.py to fetch from Open-Meteo (free, no API key needed)
# Find your coordinates at: https://www.latlong.net
LOCATION_LAT=38.8826
LOCATION_LON=-77.1116
LOCATION_NAME=Ballston, VA
